# Skabelon for miljøvariabler. Denne fil committes, .env gør ikke.
# 1. Kopiér filen til .env i samme mappe
# 2. Udfyld værdierne i .env
# Når koden får brug for en ny variabel: tilføj navnet her uden værdi.

# Kørsel: development lokalt, production på serveren
NODE_ENV=
# Porten Node lytter på (standard 3000)
PORT=
# Offentlig adresse for hotellets webapp, fx https://<domæne> (lokalt standard http://localhost:3000)
PUBLIC_URL=
# Offentlig adresse for admin, fx https://admin.<domæne> (lokalt standard http://admin.localhost:3000)
ADMIN_URL=
# Hemmelig nøgle til at signere JWT'er (mindst 32 tilfældige bytes). Lav den med:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
